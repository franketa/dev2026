# ─── Instancia de Twenty (docker-compose.yml) ─────────────────────────────────────────────────────────────
# En Coolify estas variables NO se cargan a mano: son magic variables que Coolify genera y guarda solo.
# Solo hace falta definirlas para correr el compose fuera de Coolify (ej. una instancia local de prueba).

# URL pública exacta de Twenty. En Coolify sale del dominio asignado al servicio "server".
SERVICE_URL_SERVER=http://localhost:3000
# Password de Postgres. Solo letras y números (va dentro de PG_DATABASE_URL).
SERVICE_PASSWORD_POSTGRES=cambiame
# Clave de cifrado de Twenty (`openssl rand -base64 48`). Si se pierde, se pierden los secretos guardados.
SERVICE_BASE64_64_ENCRYPTION=cambiame
# Versión de Twenty. Subirla es una decisión explícita (ver README → Actualizar Twenty).
TWENTY_TAG=v2.43.0

# ─── Scripts (scripts/*.ts) ─────────────────────────────────────────────────────────────────────────────
# Van en un archivo `.env` local (ignorado por git), nunca en el repo.

# URL de la instancia contra la que corren los scripts.
TWENTY_URL=http://localhost:3000
# API key con rol Admin (Settings → APIs & Webhooks). La usa el script de esquema.
TWENTY_ADMIN_API_KEY=
# API key del bot (rol Bot). La usa solo scripts/verify-bot.ts.
TWENTY_BOT_API_KEY=
